# DeepVerify backend environment configuration (safe placeholders only)

APP_ENV=development
LOG_LEVEL=INFO
MOCK_MODE=true

# LLM
LLM_PROVIDER=mock
LLM_MODEL=mock-gpt
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.example/v1

# Search
SEARCH_PROVIDER=mock
DOCUMENT_RETRIEVAL_PROVIDER=mock

# Research workflow
MAX_RESEARCH_ITERATIONS=3
GROUNDING_PASS_THRESHOLD=0.7

# Storage
STORAGE_DIR=./storage
